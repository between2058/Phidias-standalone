        <mxCell id="BSnKIeDcESUbGWvmWyUx-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;dashed=1;" value="GET /result/{task_id}&#xa;Client Polling 輪詢結果" vertex="1">
