        <mxCell id="BSnKIeDcESUbGWvmWyUx-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Nginx（入口 / 反向代理）&#xa;・Rate Limit：limit_req / limit_conn&#xa;・統一入口 Port 80，隱藏內部多 Port&#xa;・Proxy Pass 依 URL 路徑轉發&#xa;・proxy_read_timeout 統一逾時管理" vertex="1">
          <mxGeometry height="110" width="400" x="670" y="270" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="FastAPI API Gateway（薄層入口）&#xa;・接收 HTTP 請求，驗證參數&#xa;・生成唯一 task_id&#xa;・LPUSH 任務數據到 Redis Queue&#xa;・SET status:{task_id} = PENDING&#xa;・立即回傳 202 Accepted + task_id" vertex="1">
          <mxGeometry height="120" width="440" x="650" y="440" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="Monitor Container&#xa;（獨立 Docker 容器）&#xa;・每秒執行 nvidia-smi / pynvml&#xa;・讀取目前 GPU Free VRAM&#xa;・SET current_gpu_free to Redis" vertex="1">
          <mxGeometry height="100" width="220" x="1270" y="440" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-13" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="Redis（中心化儲存）&#xa;Task Broker + Status Store + VRAM Info&#xa;・gpu_tasks Queue：LPUSH / BLPOP 原子操作&#xa;・status:{task_id}：PENDING / SUCCESS&#xa;・current_gpu_free：目前可用 VRAM (MB)" vertex="1">
          <mxGeometry height="120" width="380" x="680" y="630" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-14" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fffbe6;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;" value="Queue 策略：&#xa;A. 通用隊列：三 Worker 競爭同一 gpu_tasks&#xa;B. 專屬隊列：model_a/b/c_tasks 各自分開&#xa;   API 依請求類型決定丟哪個 Queue" vertex="1">
          <mxGeometry height="90" width="250" x="1270" y="630" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Worker Container A&#xa;Model A（4GB VRAM）&#xa;・Celery concurrency=1&#xa;・監聽 model_a_tasks Queue&#xa;・啟動時預先載入 Model A" vertex="1">
          <mxGeometry height="100" width="210" x="290" y="840" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Worker Container B&#xa;Model B（2GB VRAM）&#xa;・Celery concurrency=1&#xa;・監聽 model_b_tasks Queue&#xa;・啟動時預先載入 Model B" vertex="1">
          <mxGeometry height="100" width="210" x="660" y="840" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Worker Container C&#xa;Model C（6GB VRAM）&#xa;・Celery concurrency=1&#xa;・監聽 model_c_tasks Queue&#xa;・啟動時預先載入 Model C" vertex="1">
          <mxGeometry height="100" width="210" x="1030" y="840" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="Autoheal Sidecar&#xa;（Docker Compose 內建）&#xa;・掛載 /var/run/docker.sock&#xa;・監控 Container healthcheck&#xa;・自動重啟 Unhealthy 容器&#xa;（不需要 K8s / Istio）" vertex="1">
          <mxGeometry height="110" width="210" x="1290" y="840" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-19" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="VRAM 足夠？&#xa;current_gpu_free &gt; MODEL_NEED_VRAM" vertex="1">
          <mxGeometry height="100" width="290" x="630" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="執行模型推理&#xa;（GPU / VRAM）&#xa;完成後執行&#xa;torch.cuda.empty_cache()" vertex="1">
          <mxGeometry height="90" width="210" x="360" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="寫入結果到 Redis&#xa;SET result:{task_id} = 推理結果&#xa;SET status:{task_id} = SUCCESS" vertex="1">
          <mxGeometry height="90" width="230" x="660" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Sleep(1) 等待&#xa;讓 VRAM 給&#xa;較小模型先用" vertex="1">
          <mxGeometry height="80" width="170" x="1010" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="BSnKIeDcESUbGWvmWyUx-23" parent="1" style="text;html=1;strokeColor=#9673a6;fillColor=#f3e8ff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;" value="Celery Visibility Timeout：&#xa;Worker 取走任務後 Redis 鎖定該任務&#xa;其他 Worker 無法看見（防止 Race Condition）&#xa;Worker 崩潰後任務逾時自動回到 Queue" vertex="1">
          <mxGeometry height="90" width="250" x="1270" y="1010" as="geometry" />
