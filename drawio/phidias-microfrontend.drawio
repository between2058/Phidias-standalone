        <mxCell id="LfwqF-Rkq7OdKXcgeoPA-27" parent="LfwqF-Rkq7OdKXcgeoPA-5" style="rounded=1;whiteSpace=wrap;html=1;" value="worker" vertex="1">
          <mxGeometry height="40" width="120" x="211" y="450" as="geometry" />
        </mxCell>
        <mxCell id="LfwqF-Rkq7OdKXcgeoPA-28" parent="LfwqF-Rkq7OdKXcgeoPA-5" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="The dispatcher only submit jobs to GPU worker from a single queue at a time. The queue from which the dispatcher dequeues does not change unless:&lt;div&gt;1. t&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;he current queue is empty and other queues are not empty&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. other non-empty queues have waited more than a tolerated time&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The dispatcher will change to the queue that has waited for the longest time 3 seconds after the criteria has been met.&lt;/span&gt;&lt;/div&gt;" vertex="1">
