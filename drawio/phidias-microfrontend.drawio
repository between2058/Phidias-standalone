        <mxCell id="RL-legend-title" value="&lt;b&gt;設計決策說明&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="45" y="808" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="RL-legend-body" value="• &lt;b&gt;Nginx burst=0 nodelay&lt;/b&gt;：不容忍 spike，超限立即 429&lt;br/&gt;• &lt;b&gt;Semaphore(1)&lt;/b&gt;：限制單 GPU 同時只跑一個推理，避免 OOM（非 thread-safe）&lt;br/&gt;• &lt;b&gt;pynvml&lt;/b&gt;：跨服務讀取同一 GPU 的 VRAM，設靜態 threshold（依服務最大需求決定）&lt;br/&gt;• &lt;b&gt;autoheal&lt;/b&gt;：等效 K8s livenessProbe，監聽 unhealthy 自動 restart（無需 k8s cluster）&lt;br/&gt;• &lt;b&gt;ThreadPoolExecutor&lt;/b&gt;：torch 同步推理不阻塞 asyncio event loop" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="45" y="830" width="530" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
