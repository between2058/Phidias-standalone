        <mxCell id="--I270Xo3OUCM5tYjzPJ-1" parent="--I270Xo3OUCM5tYjzPJ-8" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;background-color: rgb(31, 31, 31); font-family: &amp;quot;Droid Sans Mono&amp;quot;, &amp;quot;monospace&amp;quot;, monospace; line-height: 24px; white-space: pre;&quot;&gt;&lt;div style=&quot;color: rgb(204, 204, 204);&quot;&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;color: rgb(197, 134, 192);&quot;&gt;export&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;function&lt;/span&gt; &lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;createConfigWebComponent&lt;/span&gt;(&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;    element&lt;/span&gt;&lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;HTMLElement&lt;/span&gt;)&lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;AppConfig&lt;/span&gt; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;  &lt;span style=&quot;color: #569cd6;&quot;&gt;const&lt;/span&gt; &lt;span style=&quot;color: #4fc1ff;&quot;&gt;config&lt;/span&gt; &lt;span style=&quot;color: #d4d4d4;&quot;&gt;=&lt;/span&gt; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;    &lt;span style=&quot;color: #9cdcfe;&quot;&gt;apiBaseUrl&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #9cdcfe;&quot;&gt;element&lt;/span&gt;.&lt;span style=&quot;color: #dcdcaa;&quot;&gt;getAttribute&lt;/span&gt;(&lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;api-base-url&#39;&lt;/span&gt;) &lt;span style=&quot;color: #d4d4d4;&quot;&gt;??&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;&#39;&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;    &lt;span style=&quot;color: #9cdcfe;&quot;&gt;hostApp&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #9cdcfe;&quot;&gt;element&lt;/span&gt;.&lt;span style=&quot;color: #dcdcaa;&quot;&gt;getAttribute&lt;/span&gt;(&lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;host-app&#39;&lt;/span&gt;) &lt;span style=&quot;color: #d4d4d4;&quot;&gt;??&lt;/span&gt; &lt;span style=&quot;color: #569cd6;&quot;&gt;null&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;    &lt;span style=&quot;color: #9cdcfe;&quot;&gt;basePath&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #9cdcfe;&quot;&gt;element&lt;/span&gt;.&lt;span style=&quot;color: #dcdcaa;&quot;&gt;getAttribute&lt;/span&gt;(&lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;base-path&#39;&lt;/span&gt;) &lt;span style=&quot;color: #d4d4d4;&quot;&gt;??&lt;/span&gt; &lt;span style=&quot;color: #569cd6;&quot;&gt;null&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;    &lt;span style=&quot;color: #9cdcfe;&quot;&gt;user&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #9cdcfe;&quot;&gt;element&lt;/span&gt;.&lt;span style=&quot;color: #dcdcaa;&quot;&gt;getAttribute&lt;/span&gt;(&lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;user&#39;&lt;/span&gt;) &lt;span style=&quot;color: #d4d4d4;&quot;&gt;??&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;Phidias&#39;&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;  };&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;  &lt;span style=&quot;color: #4fc1ff;&quot;&gt;usePhidiasStore&lt;/span&gt;.&lt;span style=&quot;color: #dcdcaa;&quot;&gt;setState&lt;/span&gt;({ &lt;span style=&quot;color: #9cdcfe;&quot;&gt;apiBaseUrl&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #4fc1ff;&quot;&gt;config&lt;/span&gt;.&lt;span style=&quot;color: #9cdcfe;&quot;&gt;apiBaseUrl&lt;/span&gt; });&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;  &lt;span style=&quot;color: #4fc1ff;&quot;&gt;usePhidiasStore&lt;/span&gt;.&lt;span style=&quot;color: #dcdcaa;&quot;&gt;setState&lt;/span&gt;({ &lt;span style=&quot;color: #9cdcfe;&quot;&gt;hostApp&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #4fc1ff;&quot;&gt;config&lt;/span&gt;.&lt;span style=&quot;color: #9cdcfe;&quot;&gt;hostApp&lt;/span&gt; });&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;  &lt;span style=&quot;color: #4fc1ff;&quot;&gt;usePhidiasStore&lt;/span&gt;.&lt;span style=&quot;color: #dcdcaa;&quot;&gt;setState&lt;/span&gt;({ &lt;span style=&quot;color: #9cdcfe;&quot;&gt;basePath&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #4fc1ff;&quot;&gt;config&lt;/span&gt;.&lt;span style=&quot;color: #9cdcfe;&quot;&gt;basePath&lt;/span&gt; });&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;  &lt;span style=&quot;color: #4fc1ff;&quot;&gt;usePhidiasStore&lt;/span&gt;.&lt;span style=&quot;color: #dcdcaa;&quot;&gt;setState&lt;/span&gt;({ &lt;span style=&quot;color: #9cdcfe;&quot;&gt;user&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #4fc1ff;&quot;&gt;config&lt;/span&gt;.&lt;span style=&quot;color: #9cdcfe;&quot;&gt;user&lt;/span&gt; });&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;  &lt;span style=&quot;color: #c586c0;&quot;&gt;return&lt;/span&gt; &lt;span style=&quot;color: #4fc1ff;&quot;&gt;config&lt;/span&gt;;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;}&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="267.85" width="453.84" x="10" y="-20" as="geometry" />
        </mxCell>
        <mxCell id="vNBhxsl-8KsPASfX1VSI-30" parent="--I270Xo3OUCM5tYjzPJ-8" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/general/Folder_Blank.svg;" value="phidias" vertex="1">
          <mxGeometry height="24" width="29.57" x="400.00328097416485" y="189.99947138047133" as="geometry" />
        </mxCell>
        <mxCell id="FZPsjxDZrhntPYrXW51M-156" parent="--I270Xo3OUCM5tYjzPJ-8" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;" value="&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Web-Component-based integration&lt;/b&gt;&lt;div style=&quot;font-size: 16px;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;The host app (pegaverse-portal) and the web component (Phidias) communicate via props.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;The definition of props should be defined in phidias-types, which acts as an interface between the host app and the component.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;The adapter route (PhidiasRoute.jsx) should be contained in the host app, but the file to include can be configured as an environmental variable.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;host app API call inside Phidias&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;The web component (Phidias) dispatches events to its host app (pegaverse-portal) from internal components.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;The event interface should be defined in phidias-types with event maps recommended. (&amp;lt;namespace&amp;gt;:&amp;lt;event_name&amp;gt;)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;The actual function calls are conducted in the adapter route so that the functions can be imported from the host app.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="295" x="160" y="247.84999999999997" as="geometry" />
        </mxCell>
        <mxCell id="--I270Xo3OUCM5tYjzPJ-10" edge="1" parent="vNBhxsl-8KsPASfX1VSI-24" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.002;entryY=0.859;entryDx=0;entryDy=0;startArrow=classic;startFill=1;entryPerimeter=0;" target="--I270Xo3OUCM5tYjzPJ-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="275" y="264.11" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FZPsjxDZrhntPYrXW51M-151" edge="1" parent="vNBhxsl-8KsPASfX1VSI-24" source="C2vrENVOv4sDVrD1r9vF-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" target="--I270Xo3OUCM5tYjzPJ-4">
