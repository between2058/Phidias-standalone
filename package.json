{
  "name": "phidias-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:wc": "vite build --config vite.wc.config.mts",
    "build:wc:steady": "vite build --config vite.wc.config.mts --mode steady",
    "build:wc:dev": "vite build --config vite.wc.config.mts --mode development",
    "preview:wc": "bash scripts/preview-wc.sh",
    "preview:wc:dev": "bash scripts/preview-wc.sh development",
    "preview:wc:steady": "bash scripts/preview-wc.sh steady",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=developer",
    "e2e:user": "playwright test --project=user-journeys",
    "e2e:all": "playwright test",
    "e2e:ui": "playwright test --ui",
    "dev:with-library": "concurrently -n phidias,sidecar -c blue,magenta \"pnpm dev\" \"cd ../../code/articraft && uv run uvicorn viewer.api.app:app --host 127.0.0.1 --port 8765\""
  },
  "dependencies": {
    "@pegaverse/phidias-sdk": "^1.0.0",
    "@playcanvas/react": "^0.11.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@sparkjsdev/spark": "^0.1.10",
    "@types/three": "^0.183.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.2",
    "lucide-react": "^0.574.0",
    "next": "14.2.35",
    "next-swagger-doc": "^0.4.1",
    "playcanvas": "^2.16.1",
    "postprocessing": "^6.38.3",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.13.1",
    "swagger-ui-react": "^5.32.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.183.0",
    "three-stdlib": "^2.36.1",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^5.4.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "vitest": "^1.6.1"
  }
}
